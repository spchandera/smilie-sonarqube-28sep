{%- comment -%} Custom brand fonts (assets/custom.css) — preloaded so headings using them don't flash/reflow late in the page load {%- endcomment -%}
<link
  rel="preload"
  as="font"
  href="https://cdn.shopify.com/s/files/1/0565/2928/9412/files/ESBuild-Regular.woff2"
  type="font/woff2"
  crossorigin
  fetchpriority="low"
>
<link
  rel="preload"
  as="font"
  href="https://cdn.shopify.com/s/files/1/0565/2928/9412/files/ESBuild-Semibold.woff2"
  type="font/woff2"
  crossorigin
  fetchpriority="low"
>
<link
  rel="preload"
  as="font"
  href="https://cdn.shopify.com/s/files/1/0565/2928/9412/files/00WagramDisplay-Regular.woff2"
  type="font/woff2"
  crossorigin
  fetchpriority="low"
>
{% # theme-check-enable %}
