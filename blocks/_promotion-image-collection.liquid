{%- liquid
  assign block_settings = block.settings
  assign placement_index = block_settings.placement_index | default: 1

  assign columns_gap = section.settings.columns_gap_horizontal | default: 0
  capture product_card_size
    render 'util-product-grid-card-size', section: section
  endcapture
  assign product_card_size = product_card_size | strip
-%}

{%- comment -%}
  Promo Grid Banner — spans exactly 2 columns in the collection CSS Grid.
  Row and starting column are controlled per-block via Customizer settings.
{%- endcomment -%}
{%- assign display_image = block_settings.image -%}

{%- if display_image != blank -%}
  <li
    class="promotion-image-collection promo-grid-banner block-{{ block.id }}"
    style="
      --promo-order:      {{ placement_index | times: 2 }};
      --promo-order-3col: {{ placement_index | times: 2 | minus: 1 }};
      --promo-order-2col: {{ placement_index | times: 2 }};
      --promo-order-1col: {{ placement_index | times: 2 }};
    "
  >
    {%- style -%}
      .promo-grid-banner.block-{{ block.id }} {
        display: block;
      }

      .promo-grid-banner.block-{{ block.id }} > a,
      .promo-grid-banner.block-{{ block.id }} > a > .zoom-image {
        display: flex;
        height: 100% !important;
      }

      /* Baseline spanning */
      .promo-grid-banner.block-{{ block.id }} {
        order: var(--promo-order);
        grid-column: span {{ block_settings.column_span | default: 2 }};
      }

      /* 3-col container breakpoint */
      @container product-grid (max-width: calc({{ product_card_size }} * 3 + {{ columns_gap }}px * 2)) {
        .promo-grid-banner.block-{{ block.id }} {
          {% if block_settings.column_span == '2' %}grid-column: 1 / -1;{% endif %}
          order: var(--promo-order-3col);
        }
      }

      @media (min-width: 750px) and (max-width: 1145px) {
        .promo-grid-banner.block-{{ block.id }} {
          order: var(--promo-order-2col);
          aspect-ratio: 16 / 8;
        }
      }

      @media (max-width: 1500px) {
        .promo-grid-banner.block-{{ block.id }} {
          order: var(--promo-order-3col);
        }
      }

      @media (max-width: 749px) {
        .promo-grid-banner.block-{{ block.id }} {
          aspect-ratio: 16 / 9;
          min-height: 300px;
          width: 100%;
        }
      }
  
      /* 2-col container breakpoint */
      @container product-grid (max-width: calc({{ product_card_size }} * 2 + {{ columns_gap }}px * 1)) {
        .promo-grid-banner.block-{{ block.id }} {
          {% if block_settings.column_span == '2' %}grid-column: 1 / -1;{% endif %}
          order: var(--promo-order-2col);
        }
      }

      /* 1-col container breakpoint */
      @container product-grid (max-width: {{ product_card_size }}) {
        .promo-grid-banner.block-{{ block.id }} {
          grid-column: 1 / -1;
          order: var(--promo-order-1col);
        }
      }

      /* Mobile hard fallback */
      @media screen and (max-width: 749px) {
        .promo-grid-banner.block-{{ block.id }} {
          grid-column: 1 / -1 !important;
          order: var(--promo-order-1col) !important;
        }
      }
      .promo-grid-banner.block-{{ block.id }} .content-over-media {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
      }
      .promo-grid-banner.block-{{ block.id }} .content-over-media::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgb({{ block_settings.overlay_color.rgb }} / {{ block_settings.overlay_opacity | divided_by: 100.0 }});
        pointer-events: none;
        z-index: 1;
      }
      {%- liquid
        assign tp = block_settings.text_position
        case tp
          when 'place-self-start text-start'
            assign vertical = 'flex-start'
            assign horizontal = 'flex-start'
          when 'place-self-start-center text-center'
            assign vertical = 'flex-start'
            assign horizontal = 'center'
          when 'place-self-start-end text-end'
            assign vertical = 'flex-start'
            assign horizontal = 'flex-end'
          when 'place-self-center-start text-start'
            assign vertical = 'center'
            assign horizontal = 'flex-start'
          when 'place-self-center text-center'
            assign vertical = 'center'
            assign horizontal = 'center'
          when 'place-self-center-end text-end'
            assign vertical = 'center'
            assign horizontal = 'flex-end'
          when 'place-self-end-start text-start'
            assign vertical = 'flex-end'
            assign horizontal = 'flex-start'
          when 'place-self-end-center text-center'
            assign vertical = 'flex-end'
            assign horizontal = 'center'
          when 'place-self-end text-end'
            assign vertical = 'flex-end'
            assign horizontal = 'flex-end'
          else
            assign vertical = 'center'
            assign horizontal = 'center'
        endcase
      -%}
      .promo-grid-banner.block-{{ block.id }} .zoom-image {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: {{ vertical }};
        align-items: {{ horizontal }};
        padding: 40px;
        height: 100%;
        width: 100%;
      }
      .promo-grid-banner.block-{{ block.id }} .promotion-image-content {
        position: relative;
        z-index: 2;
        width: auto;
        max-width: 100%;
        color: {{ block_settings.text_color }};
        text-align: {{ horizontal | replace: 'flex-', '' | replace: 'start', 'left' | replace: 'end', 'right' }};
      }
    {%- endstyle -%}

    <a
      {% if block_settings.link_url != blank %}
        href="{{ block_settings.link_url }}"
      {% endif %}
      class="content-over-media h-full rounded-sm"
    >
      <div
        class="zoom-image content-over-media__media"
        style="background-image: url('{{ display_image | image_url: width: 1600 }}'); background-size: cover; background-position: center; width: 100%; height: 100%;"
      >
        {%- if block_settings.content != blank -%}
          <div class="promotion-image-content {{ block_settings.text_position }} promotion-content-{{ block.id }}">
            <div class="v-stack gap-4 sm:gap-6 {% if block_settings.text_position contains 'text-center' %}justify-items-center{% elsif block_settings.text_position contains 'text-end' %}justify-items-end{% endif %}">
              <div class="prose section-header">
                <div class="{{ block_settings.content_tag }}">
                  {{ block_settings.content }}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </a>
  </li>
{%- endif -%}
{% schema %}
{
  "name": "Promo Grid Banner",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "placement_index",
      "label": "Placement position",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Legacy / Content Settings"
    },
    {
      "type": "paragraph",
      "content": "Blocks may be hidden if not enough products are visible."
    },
    {
      "type": "select",
      "id": "column_span",
      "label": "Desktop item size",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "1600 x 1000px .jpg recommended"
    },

    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "content_tag",
      "label": "Content tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h4"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Content position",
      "options": [
        {
          "value": "place-self-start text-start",
          "label": "Top left"
        },
        {
          "value": "place-self-start-center text-center",
          "label": "Top center"
        },
        {
          "value": "place-self-start-end text-end",
          "label": "Top right"
        },
        {
          "value": "place-self-center-start text-start",
          "label": "Middle left"
        },
        {
          "value": "place-self-center text-center",
          "label": "Middle center"
        },
        {
          "value": "place-self-center-end text-end",
          "label": "Middle right"
        },
        {
          "value": "place-self-end-start text-start",
          "label": "Bottom left"
        },
        {
          "value": "place-self-end-center text-center",
          "label": "Bottom center"
        },
        {
          "value": "place-self-end text-end",
          "label": "Bottom right"
        }
      ],
      "default": "place-self-end-start text-start"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30
    }
  ]
}
{% endschema %}
