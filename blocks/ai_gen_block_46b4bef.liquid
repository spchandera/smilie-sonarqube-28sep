{% doc %}
  @prompt
    A magazine-style editorial layout, This isnt quite right - this is for people who want to know how the product is going to work in easy steps, can you add a step above one - i'll make this a before you begin , remove the 0 from before you begin - its doesn't need a step number, Can you add in a step above cleanse your skin that says Before you get started - don't add a a number though
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-step-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-step-guide-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-step-guide-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-step-guide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .ai-step-guide-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
    opacity: 0.8;
  }

  .ai-step-guide-steps-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.step_spacing }}px;
  }

  .ai-step-guide-step-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {% if block.settings.layout == 'image-left' %}1fr 1.5fr{% elsif block.settings.layout == 'image-right' %}1.5fr 1fr{% else %}1fr{% endif %};
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
    background-color: {{ block.settings.step_background }};
    padding: {{ block.settings.step_padding }}px;
    border-radius: {{ block.settings.step_border_radius }}px;
    border: {{ block.settings.step_border_width }}px solid {{ block.settings.step_border_color }};
  }

  .ai-step-guide-step-{{ ai_gen_id }}[data-has-number="true"]:nth-child(even) {
    {% if block.settings.alternate_layout %}
      grid-template-columns: {% if block.settings.layout == 'image-left' %}1.5fr 1fr{% elsif block.settings.layout == 'image-right' %}1fr 1.5fr{% else %}1fr{% endif %};
    {% endif %}
  }

  .ai-step-guide-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-step-guide-step-{{ ai_gen_id }}[data-has-number="true"]:nth-child(even) .ai-step-guide-image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.alternate_layout and block.settings.layout != 'stacked' %}
      order: {% if block.settings.layout == 'image-left' %}2{% else %}1{% endif %};
    {% endif %}
  }

  .ai-step-guide-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-step-guide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-step-guide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-step-guide-content-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-step-guide-step-number-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    background-color: {{ block.settings.number_background }};
    color: {{ block.settings.number_color }};
    border-radius: 50%;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .ai-step-guide-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-step-guide-step-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-step-guide-step-text-{{ ai_gen_id }} p {
    margin: 0 0 0.8em;
  }

  .ai-step-guide-step-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-step-guide-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.6 }}px;
    }

    .ai-step-guide-step-{{ ai_gen_id }},
    .ai-step-guide-step-{{ ai_gen_id }}[data-has-number="true"]:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .ai-step-guide-image-wrapper-{{ ai_gen_id }},
    .ai-step-guide-step-{{ ai_gen_id }}[data-has-number="true"]:nth-child(even) .ai-step-guide-image-wrapper-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-step-guide-content-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-step-guide-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-step-guide-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<step-by-step-guide-{{ ai_gen_id }} class="ai-step-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-step-guide-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-step-guide-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-step-guide-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-step-guide-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-step-guide-steps-{{ ai_gen_id }}">
      {% assign step_counter = 0 %}
      {% for i in (0..7) %}
        {% liquid
          assign step_enabled_key = 'step_' | append: i | append: '_enabled'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_text_key = 'step_' | append: i | append: '_text'
          assign step_image_key = 'step_' | append: i | append: '_image'

          assign step_enabled = block.settings[step_enabled_key]
          assign step_title = block.settings[step_title_key]
          assign step_text = block.settings[step_text_key]
          assign step_image = block.settings[step_image_key]
          
          assign show_number = false
          if block.settings.show_numbers and i > 0
            assign show_number = true
          endif
        %}

        {% if step_enabled %}
          <div class="ai-step-guide-step-{{ ai_gen_id }}" data-has-number="{% if show_number %}true{% else %}false{% endif %}">
            {% if block.settings.layout != 'text-only' %}
              <div class="ai-step-guide-image-wrapper-{{ ai_gen_id }}">
                {% if step_image %}
                  <img
                    src="{{ step_image | image_url: width: 800 }}"
                    alt="{{ step_image.alt | escape }}"
                    loading="lazy"
                    width="{{ step_image.width }}"
                    height="{{ step_image.height }}"
                    class="ai-step-guide-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-step-guide-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            <div class="ai-step-guide-content-{{ ai_gen_id }}">
              {% if show_number %}
                {% assign step_counter = step_counter | plus: 1 %}
                <div class="ai-step-guide-step-number-{{ ai_gen_id }}">{{ step_counter }}</div>
              {% endif %}
              {% if step_title != blank %}
                <h3 class="ai-step-guide-step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
              {% endif %}
              {% if step_text != blank %}
                <div class="ai-step-guide-step-text-{{ ai_gen_id }}">{{ step_text }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</step-by-step-guide-{{ ai_gen_id }}>

<script>
  (function() {
    class StepByStepGuide{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initSteps();
      }

      initSteps() {
        const steps = this.querySelectorAll('.ai-step-guide-step-{{ ai_gen_id }}');
        steps.forEach((step, index) => {
          step.setAttribute('data-step', index);
        });
      }
    }

    customElements.define('step-by-step-guide-{{ ai_gen_id }}', StepByStepGuide{{ ai_gen_id }});
  })();
</script>

